{
  "name": "ticketbot-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=@ticketbot/bot",
    "dev:dash": "npm run dev --workspace=@ticketbot/dashboard",
    "dev:dashboard": "npm run dev --workspace=@ticketbot/dashboard",
    "db:push": "dotenv -e .env -- npm run push --workspace=@ticketbot/db",
    "db:generate": "dotenv -e .env -- npm run generate --workspace=@ticketbot/db",
    "clean": "Remove-Item -Recurse -Force apps/dashboard/.next"
  }
}
